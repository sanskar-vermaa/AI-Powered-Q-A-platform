# Copy to .env and adjust. Every value has a safe development default.

# Required in production: a long random string used to sign login tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=please-change-this-secret-key-in-production

# Database. SQLite works out of the box; Oracle and PostgreSQL are supported too.
DATABASE_URL=sqlite:///./qa_platform.db
# DATABASE_URL=oracle+oracledb://qa:qa_password@localhost:1521/?service_name=FREEPDB1
# DATABASE_URL=postgresql+psycopg2://qa:qa_password@localhost:5432/qa

# AI. Without an API key the platform runs in offline mode with canned AI responses.
ANTHROPIC_API_KEY=
AI_PROVIDER=auto            # auto | claude | mock
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium            # low | medium | high | xhigh | max

ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173"]

# Used by docker-compose.yml
ORACLE_APP_USER=qa
ORACLE_APP_PASSWORD=qa_password
ORACLE_ADMIN_PASSWORD=oracle_admin
